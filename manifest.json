{
  "name": "Jānis Bedeicis",
  "short_name": "Kineport",
  "id": "/index.html",
  "start_url": "/",
 "display_override": ["standalone", "minimal-ui"],
 "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0059ff",
  "icons": [
    {
      "src": "/assets/icons/android-chrome-192x192.png",  
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/icons/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/media/SIGNAL_TEST.jpg",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile Home Screen"
    },
    {
      "src": "/assets/media/SIGNAL_TEST.jpg",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop Dashboard"
    }
  ],
  
  "protocol_handlers": [
    {
      "protocol": "web+tea",
      "url": "/tea?type=%s"
    },
    {
      "protocol": "web+coffee",
      "url": "/coffee?type=%s"
    }
  ]
}
